# Include inside an existing nginx http{} block. Substitute the path and cert
# locations using your own deployment configuration; this file is not executed.
map $http_upgrade $sparta_connection {
    default upgrade;
    '' close;
}

server {
    listen 8443 ssl;
    server_name node.example.com;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/sparta-error.log crit;

    location = /replace-with-your-path {
        if ($http_upgrade !~* ^websocket$) { return 404; }
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $sparta_connection;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
    location / { return 404; }
}
